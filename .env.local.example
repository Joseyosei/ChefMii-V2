# ============================================================
# ChefMii - Environment Variables Example
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ─── Supabase ───────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Stripe ─────────────────────────────────────────────────
# Found in: Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_CHEF_BOOKING_FEE_PRICE_ID=price_your-booking-fee-price-id
STRIPE_PLATFORM_FEE_PERCENT=10

# ─── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChefMii

# ─── Email (Resend or SMTP) ─────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=no-reply@chefmii.com

# ─── Storage ────────────────────────────────────────────────
# Supabase Storage is used by default (no extra config needed)
# If using external CDN, set this:
NEXT_PUBLIC_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# ─── External Maps (for chef location display) ───────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Analytics (optional) ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
